  "InclusionRules": [
    {
      "name": "hs-TnI > 2x ULN within 24h of index NSTEMI",
      "description": "High-sensitivity cardiac troponin I (LOINC 10839-9) must be > 2x the upper limit of normal (ULN = 34 ng/L; threshold = 68 ng/L) within 24 hours of the index NSTEMI condition occurrence date.",
      "expression": {
        "Type": "ALL",
        "CriteriaList": [
          {
            "Criteria": {
              "Measurement": {
                "CodesetId": 1,
                "MeasurementValue": {
                  "Value": 68.0,
                  "Op": "gt",
                  "Extent": null
                },
                "RangeHigh": {
                  "Value": 34.0,
                  "Op": "lte",
                  "Extent": null
                }
              }
            },
            "StartWindow": {
              "Start": {
                "Coeff": -1,
                "Days": 0
              },
              "End": {
                "Coeff": 1,
                "Days": 1
              },
              "UseIndexEnd": false,
              "UseEventEnd": false
            },
            "EndWindow": null,
            "RestrictVisit": false,
            "IgnoreObservationPeriod": false,
            "Occurrence": {
              "Type": 2,
              "Count": 1,
              "IsDistinct": false
            }
          }
        ],
        "DemographicCriteriaList": [],
        "Groups": []
      }
    },
    {
